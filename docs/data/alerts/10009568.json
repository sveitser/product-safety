{"id": 10009568, "reference": "A12/01586/23", "publication_date": "2023-07-05T13:45:14.175Z", "modification_date": "2023-07-05T13:45:14.178Z", "country": "Ireland", "product_category": "CHILDCARE_ARTICLES", "product_name": "Baby monitor", "product_name_specific": "Bluebell Baby Monitor", "risk_description": "The product is claimed to monitor breathing, movement and temperature, amongst other things, making parents' supervision not required. Parents will therefore assume that their careful monitoring is not necessary. However, the application that supports the monitoring system does not function correctly and this creates risks for a child. For example, if this product is used when a child is ill, there is an increased risk that the temperature of the child is not correctly monitored. In addition, there is a risk of choking, strangulation injuries etc. when a child is not properly monitored. \n", "legal_provision": "The product does not comply with the requirements of the General Product Safety Directive.", "country_of_origin": "United Kingdom", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["ASPHYXIATION", "CHOKING", "ENVIRONMENT", "HEALTH_RISK_OTHER", "INJURIES", "SECURITY", "STRANGULATION", "SUFFOCATION"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10087567, "main": true, "embedding": ""}]}