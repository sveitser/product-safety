{"id": 10003623, "reference": "A11/00109/22", "publication_date": "2022-09-22T10:32:07.588Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "France", "product_category": "PRESSURE_EQUIPMENT_VESSELS", "product_name": "Air compressor", "product_name_specific": "QUARTZ SIL540Q", "risk_description": "The product has a valve which does not correspond to the safety requirements, the materials are too thin to withstand pressure, the pressure container supports (wheels, standing support) are not correctly welded and the purging device has been installed in a place were it may not perform adequately. Furthermore, the pressure indicator device has no warning signs for excessive pressure. Finally, the simple pressure container constituting the air compressor is a falsified product, and bears a CE marking without having undergone the conformity assessment by a relevant competent European conformity assessment body. Consequently, the product may explode, injuring the users.", "legal_provision": "The product does not comply with the requirements of the Simple Pressure Vessels Directive nor with the European standard EN 286-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_11", "brands": ["Quartz (Counterfeit)"], "model_types": ["OD 245", "Quartz SIL540Q"], "risk_types": ["INJURIES"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "BAN_MARKETING_OF_PRODUCT", "PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10060982, "main": true, "embedding": ""}, {"photo_id": 10060983, "main": false, "embedding": ""}, {"photo_id": 10060984, "main": false, "embedding": ""}]}