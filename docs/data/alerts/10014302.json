{"id": 10014302, "reference": "A12/02507/24", "publication_date": "2024-08-29T12:43:29.593Z", "modification_date": "2025-12-18T09:09:28.352Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Head lamp", "product_name_specific": "Superfire", "risk_description": "The solders in the product have an excessive concentration of lead (measured value up to 85%). It also contains DBP and DEHP in plastic parts (measured value up to 1,4  and 2,1% respectively). The product contains excessive concentrations of SCCP in plastic (measured value up to 3,4%). Lead poses a risk to the environment. Phthalates poses a risk to human health and the environment. \nSCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.\n", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive) nor with the Persistent Organic Pollutants (POP) Regulation. ", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Superfire"], "model_types": ["HL76"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10199126, "main": true, "embedding": ""}, {"photo_id": 10199128, "main": false, "embedding": ""}]}