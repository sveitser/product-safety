{"id": 10119458, "reference": "SR/03317/26", "publication_date": "2026-11-17T13:25:30.911Z", "modification_date": "2026-11-17T13:25:30.912Z", "country": "France", "product_category": "TOYS", "product_name": "Soft toy", "product_name_specific": null, "risk_description": "The fibrous stuffing material of the toy is easily accessible due to the weakness of the seams. A small child may put the filling material in the mouth and choke. Additionally, the battery compartment can easily be opened without use of any tools and the batteries inside are easily accessible. If a child puts them in the mouth, the batteries can overheat and release electrolyte which can be ingested by the child and cause damage to the gastrointestinal tract.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "CHOKING"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11238962, "main": true, "embedding": ""}, {"photo_id": 11238963, "main": false, "embedding": ""}, {"photo_id": 11238964, "main": false, "embedding": ""}, {"photo_id": 11238965, "main": false, "embedding": ""}]}