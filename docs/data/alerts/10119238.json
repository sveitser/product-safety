{"id": 10119238, "reference": "SR/02862/26", "publication_date": "2026-10-08T09:36:40.952Z", "modification_date": "2026-10-08T09:36:40.953Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "PROTECTIVE_EQUIPMENT", "product_name": "Buoyancy aid", "product_name_specific": "Buoyancy Aid", "risk_description": "The product is marketed and packaged as a “life jacket”, despite being identified within the product documentation and markings as a 50N buoyancy aid. A buoyancy aid does not provide the same level of protection as a life jacket and requires active participation from the wearer to remain afloat, whereas a life jacket is designed to provide face-up flotation without user intervention. \nThe misleading description may cause consumers to overestimate the level of protection offered and use the product in circumstances for which it is not suitable, increasing the risk of drowning. ", "legal_provision": "The product does not comply with the Personal Protective Equipment Regulation (PPE).", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["GARVEE"], "model_types": ["AGJ003"], "risk_types": ["DROWNING"], "measures": ["DESTRUCTION_OF_PRODUCT", "IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11236726, "main": true, "embedding": ""}, {"photo_id": 11236727, "main": false, "embedding": ""}]}