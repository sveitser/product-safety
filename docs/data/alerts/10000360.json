{"id": 10000360, "reference": "A12/00105/20", "publication_date": "2020-01-21T14:22:06.820Z", "modification_date": "2020-06-16T08:05:57.067Z", "country": "Sweden", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo ink", "product_name_specific": "Permablend", "risk_description": "The product contains the aromatic amine 4-methyl-m-phenylenediamine (measured value: 0.96 mg/kg) and nickel (measured value: 1.5 mg/kg).\n\n\n", "legal_provision": "4-methyl-m-phenylenediamine is a skin sensitiser and may cause cancer.\n\nNickel can cause skin irritation, induce sensitisation or elicit allergic responses.\n\nThe Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up, recommends that aromatic amines with carcinogenic mutagenic, reprotoxic or sensitising properties should neither be present in tattoos and permanent make-up products nor released from azo-colourants and that nickel levels are as low as technically achievable.\n", "country_of_origin": "United States", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Tina Davies"], "model_types": ["1 Grey"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10003133, "main": true, "embedding": ""}, {"photo_id": 10003132, "main": false, "embedding": ""}]}