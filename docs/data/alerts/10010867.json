{"id": 10010867, "reference": "A12/02829/23", "publication_date": "2023-11-23T09:59:07.374Z", "modification_date": "2023-11-23T09:59:07.377Z", "country": "Germany", "product_category": "COSMETICS", "product_name": "Skin lightening product", "product_name_specific": "Lait Clarifiant, Lightening Body Lotion, Leite Clareador", "risk_description": "The product has an excessive concentration of kojic acid (measured value up to: 1.659 g/100g). Kojic acid can affect the balance of the thyroid system and also induce skin sensitisation, when used at high concentrations on hand and face, or if used on large areas of skin. The product contains clobetasol propionate (measured value up to 10 g/g), which is forbidden in cosmetic products. This corticosteroid should be applied only if medically prescribed. Exposure to it could cause skin irritation and may lead to endocrine problems. Moreover, the product also contains 2-(4-tert- butylbenzyl) propionaldehyde (BMHCA), (measured value: 0.018% by weight), which is forbidden in cosmetic products. BMHCA may harm the reproductive system, may harm the health of the unborn child and may cause skin sensitisation.", "legal_provision": "The product does not comply with the Cosmetic Products Regulation. ", "country_of_origin": "Ivory Coast", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Clair-Liss Génial"], "model_types": [], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10101357, "main": true, "embedding": ""}, {"photo_id": 10101358, "main": false, "embedding": ""}]}