{"id": 10002970, "reference": "A12/01538/21", "publication_date": "2022-01-06T12:49:44.322Z", "modification_date": "2022-01-14T15:53:10.153Z", "country": "France", "product_category": "TOYS", "product_name": "Plush toy", "product_name_specific": null, "risk_description": "The plastic material of the product contains an excessive amount of bis(2-ethylhexyl) phthalate (DEHP) (measured value up to 37% % by weight). This phthalate may harm the health of children, causing possible damage to their reproductive system. \nIn addition, the suction cup can easily detach. If a child puts the product in the mouth, the suction cup can detach leaving the airways obstructed by the suction cup. \nFinally, the stuffing material of the product is easily accessible which, if ingested, could cause choking. ", "legal_provision": "The product does not comply with the REACH Regulation, the requirements of the Toy Safety Directive and the relevant European standard EN 71-1.  ", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "CHOKING"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "photos": [{"photo_id": 10039490, "main": true, "embedding": ""}]}