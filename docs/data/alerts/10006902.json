{"id": 10006902, "reference": "A12/01408/22", "publication_date": "2022-10-12T20:53:32.615Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "Luxembourg", "product_category": "TOYS", "product_name": "Rattle toy", "product_name_specific": null, "risk_description": "Small parts can easily detach (ball and square). A small child may put them in the mouth and choke on them.\nThe handle of the rattle toy is too long and if a child puts it in the mouth it can block the airways and cause choking.\nThe sound pressure level of the bell is too high (measured value up to 111.3 dB). This could lead to permanent or partial hearing loss when the product is used.\n", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHOKING", "DAMAGE_TO_HEARING", "INJURIES"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10061955, "main": true, "embedding": ""}, {"photo_id": 10061956, "main": false, "embedding": ""}]}