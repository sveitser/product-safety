{"id": 10006636, "reference": "A12/01208/22", "publication_date": "2022-08-24T17:03:15.176Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "Poland", "product_category": "TOYS", "product_name": "Soft toy", "product_name_specific": "Lalka", "risk_description": "Small part (metal zipper) may easily detach from the toy. The fibrous stuffing material of the toy is easily accessible. A small child may put the small part and/or the stuffing material in the mouth and choke. Moreover, the plastic of the packaging is too thin. If a child plays with the packaging, the plastic can cover the mouth and nose, causing the child to suffocate. Furthermore, the battery compartment can be easily opened, leaving the button cell batteries accessible. A child may put them in the mouth and ingest them, which may lead to choking if they enter the airways, or could cause damages to the gastrointestinal tract.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standards EN 71-1 and EN 62115.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["TOYS GROUP"], "model_types": ["TG 400737"], "risk_types": ["CHEMICAL", "CHOKING", "SUFFOCATION"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "WARNING_CONSUMERS_OF_RISKS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10059268, "main": true, "embedding": ""}, {"photo_id": 10059267, "main": false, "embedding": ""}, {"photo_id": 10059269, "main": false, "embedding": ""}]}