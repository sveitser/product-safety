{"id": 10013738, "reference": "A12/01959/24", "publication_date": "2024-07-19T08:06:14.251Z", "modification_date": "2024-10-21T15:04:55.927Z", "country": "France", "product_category": "TOYS", "product_name": "Finger painting kit", "product_name_specific": "NEWEST Funny Finger Painting Kit", "risk_description": "The painting kit has small parts (the foam parts of the inkers) than can easily detach. Small children may put them in the mouth and choke. Moreover, the product has an excessive concentration of a mixture of the preservatives methylchloroisothiazolinone and methylisothiazolinone (MCI/MI) (measured values: 0.00008 % and 0.00011%). MCI and MI cause severe skin burns.\nAdditionally, the plastic bag of the packaging is too thin. If a child plays with it, the plastic can cover the mouth and nose, causing the child to suffocate.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standards EN 71-1 and EN 71-7.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "CHOKING", "SUFFOCATION"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10129772, "main": true, "embedding": ""}, {"photo_id": 10129771, "main": false, "embedding": ""}]}