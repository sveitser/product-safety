{"id": 10005040, "reference": "A12/01826/21", "publication_date": "2022-10-17T12:20:30.762Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "Belgium", "product_category": "TOYS", "product_name": "Toy musical instruments", "product_name_specific": null, "risk_description": "The various instruments have detachable small parts and protruding parts, and can easily break creating further small parts. A small child may put them in the mouth and choke. Furthermore, If the toy is used improperly it may cause damage to hearing. Finally, one of the instruments (toy drum) has a long cord that should be placed around the neck; this cord can become trapped during various activities of a child, leading to strangulation.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive and the European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["890-27"], "risk_types": ["CHOKING", "DAMAGE_TO_HEARING", "STRANGULATION"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10042615, "main": true, "embedding": ""}, {"photo_id": 10042611, "main": false, "embedding": ""}, {"photo_id": 10042612, "main": false, "embedding": ""}, {"photo_id": 10042613, "main": false, "embedding": ""}, {"photo_id": 10042614, "main": false, "embedding": ""}, {"photo_id": 10042616, "main": false, "embedding": ""}, {"photo_id": 10042617, "main": false, "embedding": ""}]}