{"id": 10119483, "reference": "SR/03454/26", "publication_date": "2026-11-25T16:02:56.448Z", "modification_date": "2026-11-25T16:02:56.450Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "MACHINERY", "product_name": "Paper cutter", "product_name_specific": "CCM Premier 92 HPM Premier 92 M10 Paper Guillotine", "risk_description": "The safety distance between the guillotine blade and the left-hand light curtain is insufficient, leading to a risk of shearing injury to the upper limbs. Moreover, the machine is inadequately guarded at the rear. It does not effectively prevent access to the knife and back gauge during operation because it has a removable guard not requiring tools to open it and its single sensor interlock is insufficient. Side access to the back gauge drive spindle is also possible. Additionally, the two-hand control with a single contact per switch connected to a standard relay is insufficient. Users may receive injuries.", "legal_provision": "The product does not comply with the requirements of the Machinery Directive.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["INJURIES"], "measures": ["MAKING_MARKETING_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11239395, "main": true, "embedding": ""}, {"photo_id": 11239393, "main": false, "embedding": ""}, {"photo_id": 11239394, "main": false, "embedding": ""}]}