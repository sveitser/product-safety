{"id": 10004746, "reference": "A12/01817/21", "publication_date": "2021-12-23T23:01:04.638Z", "modification_date": "2021-12-23T23:01:04.701Z", "country": "Sweden", "product_category": "TOYS", "product_name": "Skip rope", "product_name_specific": "Hopprep", "risk_description": "The plastic material of the rope contains an excessive amount of dibutyl phthalate (DBP), diisobutyl phthalate (DIBP) and short chain chlorinated paraffins (SCCPs) (measured values up to 0.5 %, 0.2 % and 7.0 % by weight, respectively). These phthalates may harm the health of children, causing possible damage to the reproductive system. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment.\n", "legal_provision": "The product does not comply with the REACH Regulation and the Regulation on persistent organic pollutants (POP Regulation). ", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Biltema"], "model_types": ["14-7900"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10042439, "main": true, "embedding": ""}, {"photo_id": 10042440, "main": false, "embedding": ""}]}