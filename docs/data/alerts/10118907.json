{"id": 10118907, "reference": "SR/02635/26", "publication_date": "2026-09-24T09:12:08.799Z", "modification_date": "2026-10-20T12:52:14.846Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "TOYS", "product_name": "Play tent", "product_name_specific": "Dinosaur Discovery Teepee Tent", "risk_description": "The toy's string of lights and rope are too long. They could entangle around the neck of the child and create a risk of strangulation. Moreover, the battery compartment can easily be opened without use of any tools and the batteries inside are easily accessible. If a child puts them in the mouth, the batteries can overheat and release electrolyte which can be ingested by the child and cause damage to the gastrointestinal tract.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Winson & Olive"], "model_types": ["UK04 01/2026"], "risk_types": ["CHEMICAL", "STRANGULATION"], "measures": ["DESTRUCTION_OF_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11236181, "main": true, "embedding": ""}, {"photo_id": 11236182, "main": false, "embedding": ""}]}