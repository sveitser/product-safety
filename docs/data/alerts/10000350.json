{"id": 10000350, "reference": "A12/00114/20", "publication_date": "2020-01-21T15:00:27.603Z", "modification_date": "2020-06-19T09:18:27.584Z", "country": "Sweden", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo ink", "product_name_specific": "Product for permanent makeup", "risk_description": "The product contains the aromatic amines o-anisidine, o-toluidine and 4-methyl-m-phenylenediamine (measured values: 2.0 mg/kg,  1.4 mg/kg and 0.89 mg/kg, respectively.", "legal_provision": "O-anisidine may cause cancer and might induce mutations.\n\nO-toluidine is genotoxic and may cause cancer.\n\n4-methyl-m-phenylenediamine is a skin sensitiser, may cause cancer and might induce mutations and/or affect fertility.\n\nThe Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up, recommends that aromatic amines with carcinogenic mutagenic, reprotoxic or sensitising properties should neither be present in tattoos and permanent make-up products nor released from azo-colourants. \n", "country_of_origin": "Latvia", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Icolor"], "model_types": ["Natural Brown"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10003122, "main": true, "embedding": ""}]}