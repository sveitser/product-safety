{"id": 10119755, "reference": "SR/03436/26", "publication_date": "2026-11-24T11:07:00.986Z", "modification_date": "2026-11-24T11:07:00.988Z", "country": "France", "product_category": "TOYS", "product_name": "Sensory toy ", "product_name_specific": " 6 in 1 Activity and Learners Car", "risk_description": "The sound pressure level produced by the musical percussion toy is too high (measured value: 115 dB) and the product does not bear the required warning signs concerning this risk. This could lead to permanent or partial hearing loss. Additionally, the toy has small parts (the fisher hook magnet in the hook, pieces of the plastic body of the hook and magnet) that can easily detach. A small child could put it in the mouth and choke. Moreover, these magnets have a high magnetic flux (measured value: 176 kG²mm²)  If a child swallows them, they could attract one another causing intestinal blockage or perforation. \n", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["kids game"], "model_types": ["986"], "risk_types": ["CHOKING", "DAMAGE_TO_HEARING", "INJURIES"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE", "WARNING_CONSUMERS_OF_RISKS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11242234, "main": true, "embedding": ""}, {"photo_id": 11242224, "main": false, "embedding": ""}, {"photo_id": 11242225, "main": false, "embedding": ""}, {"photo_id": 11242227, "main": false, "embedding": ""}, {"photo_id": 11242228, "main": false, "embedding": ""}, {"photo_id": 11242229, "main": false, "embedding": ""}, {"photo_id": 11242231, "main": false, "embedding": ""}, {"photo_id": 11242233, "main": false, "embedding": ""}]}