{"id": 10098970, "reference": "SR/01446/26", "publication_date": "2026-05-18T17:46:58.137Z", "modification_date": "2026-05-28T07:58:34.982Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "MACHINERY", "product_name": "Packaging machine", "product_name_specific": "Vertical Form Fill & Seal (VFFS) Machine", "risk_description": "The machine lacks safeguards at the front to prevent contact with heated sealing jaws and rotating parts, creating risks of entanglement and trapping. It also does not incorporate a suitable emergency stop button. In addition, the machine lacks earthing protection, meaning the frame and body can become live during an electrical fault. The cabinet doors are secured only by plastic latches, allowing access to live electrical and moving mechanical parts during operation. External electrical cables are also not properly supported or secured, making them vulnerable to damage and exposing live conductors. These defects increase the risk of electric shock, burns, and serious injuries to operators.", "legal_provision": "The product does not comply with the requirements of the Machinery Directive.", "country_of_origin": "United Kingdom", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Machinery Automation"], "model_types": [], "risk_types": ["BURNS", "ELECTRIC_SHOCK", "INJURIES"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "photos": [{"photo_id": 11008301, "main": true, "embedding": ""}]}