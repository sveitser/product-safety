{"id": 10002205, "reference": "A12/01371/20", "publication_date": "2020-10-13T15:04:29.969Z", "modification_date": "2020-10-13T15:04:29.971Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Popcorn Maker", "product_name_specific": null, "risk_description": "The plastic \"feet\" on the popcorn maker contain an excessive amount of lead (measured value up to 0,17-0,2% by weight). \nThe cable insulation contains an excessive amount of short chain chlorinated paraffins (SCCPs) (measured value up to 0,562-0,580% by weight).\nLead poses a risk to the environment and is harmful to human health, as it accumulates in the body, can cause developmental neurotoxicity and may affect breast-fed or unborn children.\nSCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment.", "legal_provision": "The product does not comply with the Persistent Organic Pollutants (POPs) Regulation and with the requirements of the Commission Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive).", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Melissa"], "model_types": ["AK-D021"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10017254, "main": true, "embedding": ""}, {"photo_id": 10017255, "main": false, "embedding": ""}, {"photo_id": 10017256, "main": false, "embedding": ""}]}