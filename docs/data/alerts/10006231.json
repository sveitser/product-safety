{"id": 10006231, "reference": "A12/00822/22", "publication_date": "2022-06-02T07:28:14.488Z", "modification_date": "2022-06-02T07:28:18.513Z", "country": "Hungary", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Hair dryer", "product_name_specific": "PROFESSIONAL HAIR DRYER", "risk_description": "The hair dryer does not have a thermal cut-out device. The plastic material of the casing is combustible. The hair dryer can overheat and catch fire during use causing burns to the user.\nThe distance between the heater and the safety grille is less than required. The wire ends are not adequately protected against pulling and twisting. The internal conductor of the mains connection cable, which is too thin, may be broken. The dimensions of the mains plug are substantially less than required. The user could touch accessible live parts, which may cause an electric shock.", "legal_provision": "The product does not comply with the requirements of the Low Voltage Directive nor with the European standard EN 60335.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["LEOVIN"], "model_types": ["LE-880 "], "risk_types": ["BURNS", "ELECTRIC_SHOCK", "FIRE"], "measures": ["IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10054814, "main": true, "embedding": ""}, {"photo_id": 10054788, "main": false, "embedding": ""}, {"photo_id": 10054796, "main": false, "embedding": ""}, {"photo_id": 10054810, "main": false, "embedding": ""}]}