{"id": 10012476, "reference": "A12/00921/24", "publication_date": "2024-04-17T16:09:51.994Z", "modification_date": "2024-04-30T13:30:05.095Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Magnifier glass", "product_name_specific": "Magnifier with auxiliary clip ", "risk_description": "The solders in the product have an excessive concentration of lead and cadmium (measured values: up to 82% and 0.19% by weight, respectively). The plastic material of the cable has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP) and short chain chlorinated paraffins (SCCPs) (measured values: up to 0.33% and 4.4% by weight, respectively). Lead poses a risk to the environment. Cadmium bio-accumulates and poses a risk to the environment. DEHP poses a risk to human health and the environment. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS Directive) nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Product Resoultion"], "model_types": ["TE800"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10118187, "main": true, "embedding": ""}, {"photo_id": 10118188, "main": false, "embedding": ""}]}