{"id": 10000223, "reference": "A12/00016/20", "publication_date": "2020-01-16T12:17:00.977Z", "modification_date": "2020-06-09T06:49:09.302Z", "country": "United Kingdom", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Self-balancing scooter (Hoverboard)", "product_name_specific": "P5B Hoverboard", "risk_description": "The wheels of the hoverboard can inadvertently operate while the device is being held off the ground by the user. \nConsequently, the hand or other body parts of the person could become trapped, leading to injuries.\n", "legal_provision": "The charger lacks an adequate over-current protection device and has accessible live parts. Additionally, the creepage and clearance distances between primary and accessible secondary circuits are insufficient.\nConsequently, the user could receive an electric shock or cause the product to overheat leading to fire.\n\nThe product does not comply with the requirements of the Low Voltage and Machinery Directives and the relevant European standard EN 62368-1.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["enet"], "model_types": ["P5", "P5B", "P5C"], "risk_types": ["ELECTRIC_SHOCK", "FIRE", "INJURIES"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10002782, "main": true, "embedding": ""}, {"photo_id": 10002781, "main": false, "embedding": ""}]}