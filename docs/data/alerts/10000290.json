{"id": 10000290, "reference": "A12/00109/20", "publication_date": "2020-01-21T14:28:13.075Z", "modification_date": "2020-06-16T08:04:37.375Z", "country": "Sweden", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo ink", "product_name_specific": "Black Brown", "risk_description": "The product contains nickel (measured value: 50 mg/kg) as well as an excessive amount of zinc and arsenic (measured values: 210 mg/kg and 5.6 mg/kg).", "legal_provision": "Nickel can cause skin irritation, induce sensitisation or elicit allergic responses.\n\nZinc is toxic and may cause neurological disorders.\n\nArsenic is toxic and might cause cancer. \n\nThe Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up recommends that the levels of nickel are as low as technically achievable and that the levels of impurities of zinc do not exceed 50 ppm and of arsenic 2 ppm.\n", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["XPMU"], "model_types": ["Tattoo ink for permanent make-up"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10003117, "main": true, "embedding": ""}]}