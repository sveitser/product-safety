{"id": 10095540, "reference": "SR/02915/25", "publication_date": "2025-08-06T15:52:12.804Z", "modification_date": "2025-08-06T15:52:12.805Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Electric mosquito repellent ", "product_name_specific": "Myggavvisare", "risk_description": "The product has an excessive concentration of short chain chlorinated paraffins (SCCPs) (measured value up to 1.3% by weight). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer. Moreover, the solders of the product have an excessive concentration of lead and the plastic material of the cable has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP) and dibutyl phthalate (DBP) (measured values up to 75%, 2.2 and 0.2 by weight, respectively). Lead poses a risk to the environment, while these phthalates pose a risk to human health and the environment.\n", "legal_provision": "The product does not comply with the Persistent Organic Pollutants (POP) Regulation nor with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS Directive). \n", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Fresh Kid "], "model_types": ["3019"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10971635, "main": true, "embedding": ""}, {"photo_id": 10971636, "main": false, "embedding": ""}]}