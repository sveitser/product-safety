{"id": 10096281, "reference": "SR/03650/25", "publication_date": "2025-10-18T06:46:24.917Z", "modification_date": "2025-11-03T08:29:06.079Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Irrigation set", "product_name_specific": "Automatiskt droppvattningssystem", "risk_description": "The plastic material of cables has an excessive concentration of lead and dibutyl phthalate (DBP) (measured values up to 0.25 % and 8.6 % by weight, respectively). The cables also contain short chained chlorinated paraffins (SCCPs) (measured value up to 30.5 % by weight).\nLead poses a risk to the environment.\nDBP poses a risk to human health and the environment.\nSCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.\n\n", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive) nor the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["V0103438"], "risk_types": ["ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10980889, "main": true, "embedding": ""}, {"photo_id": 10980890, "main": false, "embedding": ""}]}