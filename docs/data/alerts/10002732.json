{"id": 10002732, "reference": "A12/01684/21", "publication_date": "2021-12-01T14:19:23.828Z", "modification_date": "2021-12-09T12:56:53.971Z", "country": "France", "product_category": "TOYS", "product_name": "Soft toy", "product_name_specific": null, "risk_description": "The suction cup on top of the soft toy's head detaches easily. A child can put it in the mouth and choke on it. \nThe suction cup also contains an excessive amount of bis(2-ethylhexyl) phthalate (DEHP) (measured value up to 19.4% by weight). This phthalate may harm the health of children, causing possible damage to their reproductive system.\nThe plastic bag of the packaging is too thin. If a child plays with the packaging, the plastic can cover the mouth and nose, causing the child to suffocate. \n", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive and European standard EN 71-1. ", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "CHOKING", "SUFFOCATION"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10040697, "main": true, "embedding": ""}, {"photo_id": 10040698, "main": false, "embedding": ""}]}