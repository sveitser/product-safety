{"id": 10003814, "reference": "A12/00777/21", "publication_date": "2021-06-25T09:25:18.061Z", "modification_date": "2021-12-13T08:46:13.240Z", "country": "Hungary", "product_category": "MACHINERY", "product_name": "Electric scooter", "product_name_specific": "Kids Kick Electric Scooter", "risk_description": "The battery does not have a device that monitors the cells temperature, hence during charging it may overheat, and the e-scooter may ignite. The product may cause a fire and the user may suffer burns. In addition, the end of the scooter handle has a smaller diameter than required, hence the user's hands may slip down while the user is riding the scooter. Furthermore, The diameter of the locking holes on the handlebar is larger than the required value and shear points are formed at the holes which can cause injures of the fingers.", "legal_provision": "The product does not comply with the requirements of the Machinery Directive and of the relevant European standard EN 62133-2 and the European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Denver"], "model_types": ["SCK-5300 Black "], "risk_types": ["BURNS", "FIRE", "INJURIES"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "PRODUCT_RECALL_FROM_CONSUMERS"], "photos": [{"photo_id": 10031003, "main": true, "embedding": ""}, {"photo_id": 10030999, "main": false, "embedding": ""}, {"photo_id": 10031000, "main": false, "embedding": ""}, {"photo_id": 10031001, "main": false, "embedding": ""}, {"photo_id": 10031002, "main": false, "embedding": ""}]}