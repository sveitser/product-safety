{"id": 10004218, "reference": "A12/01137/21", "publication_date": "2021-07-27T10:33:03.439Z", "modification_date": "2021-07-27T10:42:17.791Z", "country": "Germany", "product_category": "PROTECTIVE_EQUIPMENT", "product_name": "Particle filter mask", "product_name_specific": "Protective Mask FFP2 Partikelfiltrierende Halbmask", "risk_description": "The product bears a CE marking but its declaration of conformity is not complete; additionally, the appropriate warnings and instructions for use are missing.\nThe particle/filter retention of the material is insufficient (measured values: as low as 85%); hence, the product does not fulfil the health and safety requirements. Furthermore, the mask does not properly adapt to the face.\nConsequently, an excessive amount of particles or microorganisms might pass through the mask, increasing the risk of infection; thus, even if combined with other recommended measures, it may not properly protect.", "legal_provision": "The product does not comply with the Personal Protective Equipment (PPE) Regulation and with the relevant European standard EN 149.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Eversmart Nano"], "model_types": ["HZ-KN95 Super Safe"], "risk_types": ["HEALTH_RISK_OTHER"], "measures": ["STOP_OF_SALES", "PRODUCT_RECALL_FROM_CONSUMERS", "STOP_OF_SALES"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10034482, "main": true, "embedding": ""}, {"photo_id": 10034483, "main": false, "embedding": ""}, {"photo_id": 10034484, "main": false, "embedding": ""}, {"photo_id": 10034485, "main": false, "embedding": ""}]}