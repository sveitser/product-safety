{"id": 10093858, "reference": "SR/01271/25", "publication_date": "2025-04-02T10:15:14.255Z", "modification_date": "2025-04-15T14:41:56.191Z", "country": "Finland", "product_category": "TOYS", "product_name": "Soft toy ", "product_name_specific": "Sleepy Cuddly Toy ", "risk_description": "The plastic of the packaging is too thin. If a child plays with it, the plastic can cover the mouth and nose, causing the child to suffocate. Furthermore, the toy's electrical wires are too long and can become trapped during various activities of a child, leading to strangulation. Furthermore the fibrous stuffing material of the toy is easily accessible due to the weakness of certain seams. A small child may put the filling material in the mouth and choke.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHOKING", "STRANGULATION", "SUFFOCATION"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10955559, "main": true, "embedding": ""}, {"photo_id": 10955560, "main": false, "embedding": ""}, {"photo_id": 10955561, "main": false, "embedding": ""}, {"photo_id": 10955562, "main": false, "embedding": ""}]}