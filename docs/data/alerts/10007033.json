{"id": 10007033, "reference": "A12/01625/22", "publication_date": "2022-11-15T11:23:17.195Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "Spain", "product_category": "CHILDCARE_ARTICLES", "product_name": "Baby carrier", "product_name_specific": "Full-Buckle babytrage- Saint Tropez anthrazit Baby", "risk_description": "The product label comes off easily. A child may put it in the mouth and choke. Additionally, the straps of the head rests are too long and the child's neck could become entangled in them. The straps to adjust the bridge width for the baby’s legs are longer than prescribed, which cause injuries to the child.\nThe product is sold with a textile bag with drawstrings. If a child puts the head inside the bag and pulls the drawstring to close it, the child may get strangled by it. ", "legal_provision": "The product does not comply with the requirements of the General Product Safety Directive nor with European standard 16512.", "country_of_origin": "Unknown", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Fidella"], "model_types": ["FIDELLA FUSION"], "risk_types": ["CHOKING", "INJURIES", "STRANGULATION"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10064167, "main": true, "embedding": ""}, {"photo_id": 10064168, "main": false, "embedding": ""}]}