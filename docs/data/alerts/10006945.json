{"id": 10006945, "reference": "A12/01479/22", "publication_date": "2022-10-27T09:02:44.077Z", "modification_date": "2022-10-27T09:02:44.078Z", "country": "Norway", "product_category": "TOYS", "product_name": "Electric insect trap", "product_name_specific": "USB Vacuum Insects Trap Catcher", "risk_description": "The solder has an excessive concentration of lead (Pb) (measured value up to 38.08%). Lead poses a risk to the environment. The plastic wire cape of the toy contains an excessive amount of bis(2-ethylhexyl) phthalate (DEHP), dibutyl phthalate (DBP), Diisononyl phthalate (DINP) (measured values up to 2.30%, 2.18% and 2.44% by weight respectively). These phthalates may harm the health of children, possibly causing damage to their reproductive system. The product also contains short chain chlorinated paraffins (SCCPs) (measured value 4%). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment.\n", "legal_provision": "The product does not comply with the REACH Regulation nor with the Regulation on persistent organic pollutants (POP Regulation).\n", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["SM100174"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10062857, "main": true, "embedding": ""}, {"photo_id": 10062858, "main": false, "embedding": ""}, {"photo_id": 10062859, "main": false, "embedding": ""}, {"photo_id": 10062860, "main": false, "embedding": ""}, {"photo_id": 10062861, "main": false, "embedding": ""}]}