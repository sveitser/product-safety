{"id": 10004370, "reference": "A12/01306/21", "publication_date": "2021-09-14T07:13:16.996Z", "modification_date": "2021-09-14T07:16:36.895Z", "country": "Hungary", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Self-balancing scooter (hoverboard)", "product_name_specific": "2Drive LED  Series Balance Scooter", "risk_description": "The battery does not have a device that monitors the cells temperature, hence it may overheat during charging, and the hoverboard cover may ignite. The product may cause a fire and the user may suffer burns. In addition, the power cords, which are exposed to movement between the two motors, are routed through a steel pipe with sharp edges at both ends. During the life of the product, the insulation of the power cords can be damaged by the sharp edges, the battery may short-circuit and explode during use. As a result, the user might lose control and fall off the scooter and suffer injuries.", "legal_provision": "The product does not comply with the requirements of the relevant European standards EN 60335 and EN 62133.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["2Drive"], "model_types": ["2D-LED-R and SMART S (on the packaging label)"], "risk_types": ["BURNS", "FIRE", "INJURIES"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10036280, "main": true, "embedding": ""}, {"photo_id": 10036276, "main": false, "embedding": ""}, {"photo_id": 10036277, "main": false, "embedding": ""}, {"photo_id": 10036278, "main": false, "embedding": ""}, {"photo_id": 10036279, "main": false, "embedding": ""}, {"photo_id": 10036281, "main": false, "embedding": ""}, {"photo_id": 10036282, "main": false, "embedding": ""}]}