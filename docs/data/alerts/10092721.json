{"id": 10092721, "reference": "INFO/00007/25", "publication_date": "2025-01-14T15:11:01.871Z", "modification_date": "2025-01-14T15:11:01.873Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "TOYS", "product_name": "Soft toy", "product_name_specific": "Blue Plush Octopus with Small Suction Cup", "risk_description": "The product has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP) and dibutyl phthalate (DBP) (measured values: 4.6% and 15.6% by weight, respectively). These phthalates may harm the health of children, possibly causing damage to the reproductive system.\n\nAdditionally, the toy contains small parts (suction cup) which can easily detach. A small child may put them in the mouth and choke. \nMoreover, the fibrous stuffing material of the toy is easily accessible due to the weakness of certain seams. A small child may put the filling material in the mouth and choke.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor the REACH Regulation.", "country_of_origin": "Unknown", "sold_online": "UNKNOWN", "notification_type": "FOR_INFORMATION", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "CHOKING"], "measures": ["STOP_OF_SALES"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10943656, "main": true, "embedding": ""}, {"photo_id": 10943657, "main": false, "embedding": ""}]}