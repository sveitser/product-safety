{"id": 10008311, "reference": "A12/00640/23", "publication_date": "2023-03-28T10:09:18.472Z", "modification_date": "2023-03-28T10:09:18.474Z", "country": "Sweden", "product_category": "TOYS", "product_name": "Plastic doll ", "product_name_specific": "Docka 22 cm", "risk_description": "Plastic parts of the doll have excessive concentration of bis(2-ethylhexyl)phthalate (DEHP) and dibutyl phthalate (DBP) (measured value up to 33% and 0.4% by weight, respectively). These phthalates may harm the health of children, possibly causing damage to their reproductive systems. The plastic in the arms has an excessive concentration of short-chain chlorinated paraffins (SCCPs) (measured value: up to 0.66% by weight). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment.", "legal_provision": "The product does not comply with the REACH Regulation nor with the Persistent Organic Pollutants (POPs) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Diversity Fashion"], "model_types": ["13378S"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10075543, "main": true, "embedding": ""}, {"photo_id": 10075542, "main": false, "embedding": ""}]}