{"id": 10092105, "reference": "A12/03235/24", "publication_date": "2024-11-19T15:26:38.824Z", "modification_date": "2025-02-19T12:49:09.151Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "USB fan", "product_name_specific": "USB Hand fan with stand function", "risk_description": "The plastic material of the charging cable has an excessive concentration of lead, bis(2-ethylhexyl) phthalate (DEHP) and short chain chlorinated paraffins (SCCPs) (measured values up to 0.3%, 2.6% and 2.6% by weight, respectively). Lead poses a risk to the environment. DEHP poses a risk to human health and the environment. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.\n", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS Directive), nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Goobay"], "model_types": ["49645"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10935479, "main": true, "embedding": ""}, {"photo_id": 10935480, "main": false, "embedding": ""}, {"photo_id": 10935481, "main": false, "embedding": ""}]}