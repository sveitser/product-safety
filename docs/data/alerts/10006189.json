{"id": 10006189, "reference": "A12/01024/22", "publication_date": "2022-07-29T06:02:25.239Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "Latvia", "product_category": "LIGHTING_CHAINS", "product_name": "Lighting chain", "product_name_specific": "Ziemasvētku virtenes", "risk_description": "The product is marketed for outdoor use but it is not correctly insulated against moisture, and its outside casing can easily break and let water in the control unit and inside the socket for connecting additional sections. Also, the flashing control unit can break, allowing access to live parts, while the design of the plug and the auxiliary socket does not ensure a safe connection with other chains. Moreover, the wires are not sufficiently resistant, the electrical insulation is inadequate and the clearance/creepage distances between the primary and accessible secondary circuits are not sufficient, hence accessible parts may become live. A user may receive an electric shock.\nFurthermore, the power supply pallet may catch fire; a user may suffer burns.\n", "legal_provision": "The product does not comply with the requirements of the Low Voltage Directive nor with the European standards EN 60598-1 and EN 60598-2-20.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["BURNS", "ELECTRIC_SHOCK", "FIRE"], "measures": ["OTHER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10056844, "main": true, "embedding": ""}, {"photo_id": 10056840, "main": false, "embedding": ""}, {"photo_id": 10056841, "main": false, "embedding": ""}, {"photo_id": 10056842, "main": false, "embedding": ""}, {"photo_id": 10056843, "main": false, "embedding": ""}, {"photo_id": 10057807, "main": false, "embedding": ""}, {"photo_id": 10057808, "main": false, "embedding": ""}]}