{"id": 10012334, "reference": "A12/00993/24", "publication_date": "2024-04-25T06:50:18.925Z", "modification_date": "2024-04-25T06:50:18.928Z", "country": "The Netherlands", "product_category": "PYROTECHNIC_ARTICLES", "product_name": "Fireworks", "product_name_specific": "Pyro Bliss", "risk_description": "The article has too many duds with and without fuse, children can pick these up and ignite them, causing injuries and/or burns. \nIt also expels excessive quantities of burning pieces outside the safety distance, which can cause injuries and/or burns to the user or bystanders or cause a fire. \nIn addition, the sound pressure level of the fireworks is too high, posing a risk for serious injury to hearing of the user and bystanders. \nMoreover the product has an inadequate fuse delay (too short or too long) which may cause the user to walk to the article too early or not having enough time to reach a safe distance from the fireworks.\n", "legal_provision": "The product does not comply with the requirements of the Pyrotechnics Directive nor with the European standard EN 15947.", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Wolff Vuurwerk B.V."], "model_types": ["2508"], "risk_types": ["BURNS", "DAMAGE_TO_HEARING", "INJURIES"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "DESTRUCTION_OF_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10119168, "main": true, "embedding": ""}, {"photo_id": 10119169, "main": false, "embedding": ""}, {"photo_id": 10119170, "main": false, "embedding": ""}]}