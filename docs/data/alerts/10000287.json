{"id": 10000287, "reference": "A12/00110/20", "publication_date": "2020-01-21T14:29:46.422Z", "modification_date": "2020-06-16T08:11:10.593Z", "country": "Sweden", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo ink", "product_name_specific": " Mudslide ", "risk_description": " The product contains the aromatic amine o-toluidine (measured value: 42 mg/kg) and an excessive amount of polycyclic aromatic hydrocarbons (PAHs) (measured total value: 0.6 mg/kg). \n", "legal_provision": "O-toluidine can cause cancer, cell mutations and affect reproduction.\n\nPAHs may cause cancer. \n\nThe Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up, recommends that aromatic amines with carcinogenic, mutagenic, reprotoxic or sensitising properties should neither be present in tattoos and permanent make-up products nor released from azo-colourants and that the levels of impurities of PAHs in tattoo inks do not exceed 0,5 ppm.", "country_of_origin": "United States", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Eternal Ink"], "model_types": ["Mudslide"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10003115, "main": true, "embedding": ""}]}