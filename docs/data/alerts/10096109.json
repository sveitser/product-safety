{"id": 10096109, "reference": "SR/03475/25", "publication_date": "2025-10-03T05:38:57.717Z", "modification_date": "2025-10-03T05:38:57.718Z", "country": "Sweden", "product_category": "OTHER", "product_name": "Plastic rain poncho", "product_name_specific": null, "risk_description": "The plastic material of the packaging has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP) (measured value up to 18.2 % by weight). The packaging has an excessive concentration of cadmium (measured value up to 0.039 % by weight) and short chain chlorinated paraffins (SCCPs) (measured value up to 3.98 % by weight). DEHP may harm the health by causing possible damage to the reproductive system. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment.\n. Cadmium is harmful to human health because it accumulates in the body, can damage the kidneys and bones and it may cause cancer.\n", "legal_provision": "The product does not comply with the REACH Regulation nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "Unknown", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10978663, "main": true, "embedding": ""}]}