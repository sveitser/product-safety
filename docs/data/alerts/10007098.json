{"id": 10007098, "reference": "A12/01635/22", "publication_date": "2023-01-24T14:15:22.856Z", "modification_date": "2023-01-24T14:16:01.169Z", "country": "Germany", "product_category": "MACHINERY", "product_name": "Laser engraving machine", "product_name_specific": "LaserPecker L1", "risk_description": "The product can be used without a protective casing/screen, and the protective cap on the laser head leaves a gap between the laser head cover and the workpiece when the laser head is at either its highest or lowest possible position. In addition, there is no protection against the laser radiation, which can be reflected by the work item. Furthermore, the machine may tip over. Users' or bystanders' eyes may be directly exposed to the laser light, resulting in damage to the eyesight.", "legal_provision": "The product does not comply with the requirements of the Machinery Directive nor with the European standard EN 60825-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["LaserPecker"], "model_types": ["L1"], "risk_types": ["DAMAGE_TO_SIGHT"], "measures": ["WARNING_CONSUMERS_OF_RISKS", "PRODUCT_RECALL_FROM_CONSUMERS", "REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10064195, "main": true, "embedding": ""}, {"photo_id": 10064193, "main": false, "embedding": ""}, {"photo_id": 10064194, "main": false, "embedding": ""}, {"photo_id": 10064196, "main": false, "embedding": ""}, {"photo_id": 10064197, "main": false, "embedding": ""}, {"photo_id": 10064198, "main": false, "embedding": ""}]}