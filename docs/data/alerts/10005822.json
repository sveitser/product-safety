{"id": 10005822, "reference": "A12/00540/22", "publication_date": "2022-04-07T09:34:07.568Z", "modification_date": "2022-04-07T09:44:40.525Z", "country": "Germany", "product_category": "PRESSURE_EQUIPMENT_VESSELS", "product_name": "Air blaster", "product_name_specific": "40 Liter Reifenfüller", "risk_description": "The product's safety valve does not correspond to the safety levels requested for this type of pressure equipment, and the welds are inappropriate. Moreover, neither the pressure tank nor the safety valve have a permanent marking for the maximal permissible operating pressure or safety pressure, and the manometer does not have a red warning mark.\nFurthermore, the product is supplied in parts for self-assembly, but without instructions to do so. Instructions for the product use are not fixed to the product's parts, but may be attached by the assembler.\nThe pressure vessel may burst and parts of the product can hit users and bystanders causing serious injury.", "legal_provision": "The product does not comply with the requirements of the Pressure Equipment Directive.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["200-AC-YCZYQ-1370"], "risk_types": ["INJURIES"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10051111, "main": true, "embedding": ""}, {"photo_id": 10051108, "main": false, "embedding": ""}, {"photo_id": 10051109, "main": false, "embedding": ""}, {"photo_id": 10051110, "main": false, "embedding": ""}, {"photo_id": 10051112, "main": false, "embedding": ""}]}