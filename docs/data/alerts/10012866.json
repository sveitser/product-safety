{"id": 10012866, "reference": "A12/01216/24", "publication_date": "2024-05-14T09:35:57.302Z", "modification_date": "2024-05-14T09:35:59.810Z", "country": "France", "product_category": "TOYS", "product_name": "Playground with slide and swing", "product_name_specific": "Smart Dash", "risk_description": "The product lacks a barrier on the platform , which may lead the child to fall and be injured. Moreover, there are openings between the slide and the structure's support where the child's head can be entrapped. The gap between the swing and the platform of the slide is also too small. A child can place the swing on the slide and slip, causing risk of strangulation and injuries. The swing lacks fastening elements. If the swing is not fixed to the ground, it can tip onto a child, causing a risk of injury.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standard EN 71-8.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Wickey"], "model_types": ["614476"], "risk_types": ["ENTRAPMENT", "INJURIES", "STRANGULATION"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10121785, "main": true, "embedding": ""}, {"photo_id": 10121784, "main": false, "embedding": ""}]}