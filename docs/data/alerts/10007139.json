{"id": 10007139, "reference": "A12/01657/22", "publication_date": "2022-11-22T18:03:48.923Z", "modification_date": "2022-12-21T23:00:00.000Z", "country": "Germany", "product_category": "MACHINERY", "product_name": "Laser engraving machine", "product_name_specific": "Totem 60P", "risk_description": "The product does not have a protective housing that prevents access to laser radiation, no manual reset nor key-operated main switch, and lacks an emission warning device. In addition, the laser does not switch off in the event of vibration or impact and the engraving programme continues to run autonomously after interruption and restoring of power supply. Furthermore, the product is mis-labelled as Class 3 laser but should be considered as a Class-4 laser, lacks a machine type plate, and has no operating instructions in the national language. Users' or bystanders' eyes may be directly exposed to the laser light, resulting in damage to the eyesight.", "legal_provision": "The product does not comply with the requirements of the Machinery Directive nor with the European standards EN 60825-1 and EN 60825-4.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Twotrees"], "model_types": ["DB-5500"], "risk_types": ["DAMAGE_TO_SIGHT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10064603, "main": true, "embedding": ""}, {"photo_id": 10064604, "main": false, "embedding": ""}, {"photo_id": 10064605, "main": false, "embedding": ""}, {"photo_id": 10064606, "main": false, "embedding": ""}, {"photo_id": 10064607, "main": false, "embedding": ""}]}