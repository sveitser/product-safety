{"id": 10007545, "reference": "A12/00049/23", "publication_date": "2023-01-12T10:05:51.568Z", "modification_date": "2023-01-12T10:05:51.570Z", "country": "Norway", "product_category": "CLOTHING_TEXTILES", "product_name": "Children's sandals", "product_name_specific": "Plastsandal PVC, barn", "risk_description": "The plastic material of the product contains excessive concentrations of dibutyl phthalate (DBP) and bis(2-ethylhexyl) phthalate (DEHP) (measured values 17,78% and 4,93% by weight, respectively) and short chain chlorinated paraffins (SCCPs) (measured value up to 0,29%). These phthalates may harm the health by possibly causing damage to the reproductive system. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment.\nMoreover, the metal button on the sandals releases an excessive amount of nickel (measured value up to 14,9 μg/cm²/week). Nickel is a strong sensitiser and causes allergic reactions if present in articles that come into direct and prolonged contact with the skin.\n", "legal_provision": "The product does not comply with the REACH Regulation nor with the Persistent Organic Pollutants (POPs) Regulation.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["OTHER", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10068725, "main": true, "embedding": ""}, {"photo_id": 10068723, "main": false, "embedding": ""}, {"photo_id": 10068724, "main": false, "embedding": ""}, {"photo_id": 10068726, "main": false, "embedding": ""}]}