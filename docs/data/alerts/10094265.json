{"id": 10094265, "reference": "SR/01722/25", "publication_date": "2025-05-02T07:53:08.068Z", "modification_date": "2025-05-02T07:53:08.070Z", "country": "Germany", "product_category": "MACHINERY", "product_name": "Waste-collection vehicle", "product_name_specific": null, "risk_description": "The vehicle’s crusher can be operated either automatically or manually. In the latter case the crusher is set in motion and the roller shutter remains open. If such an operation is initiated by means of the ‘Start crusher’ button, the fact that the shutter is not closed means that the hazard area can be entered whilst the crusher is running.  There is a risk that the upper extremities of a person could be caught in the unprotected moving crusher after the latter has been started manually. ", "legal_provision": "The product does not comply with the requirements laid down in the Machinery Directive and the European standard EN 1501-1. ", "country_of_origin": "The Netherlands", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Van Schijndel Maasbracht B.V."], "model_types": ["VSA II – 2025 ACB 700 – D"], "risk_types": ["INJURIES"], "measures": ["OTHER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10958601, "main": true, "embedding": ""}, {"photo_id": 10958602, "main": false, "embedding": ""}]}