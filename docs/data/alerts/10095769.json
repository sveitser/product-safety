{"id": 10095769, "reference": "SR/03123/25", "publication_date": "2025-08-28T08:08:55.838Z", "modification_date": "2025-08-28T08:08:55.839Z", "country": "Sweden", "product_category": "LIGHTING_EQUIPMENT", "product_name": "Camping lantern", "product_name_specific": "Camping-lamp", "risk_description": "The solders in the product have an excessive concentration of lead (measured value up to 61.4% by weight). The plastic has an excessive concentration of short-chain chlorinated paraffins (SCCPs) (measured value up to 5.9 % by weight). The plastic also has an excessive concentration of dibutyl phthalate (DBP) and  bis(2- ethylhexyl) phthalate (DEHP) (measured values up to 0.89 and 1.52 % by weight respectively). Lead poses a risk to the environment. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer. DBP and DEHP pose a risk to human health and the environment.\n", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive) nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Benson Outdoor"], "model_types": ["014360/Y5110"], "risk_types": ["ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10974674, "main": true, "embedding": ""}, {"photo_id": 10974675, "main": false, "embedding": ""}]}