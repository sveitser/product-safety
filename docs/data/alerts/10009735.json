{"id": 10009735, "reference": "A12/01669/23", "publication_date": "2023-07-20T10:20:43.063Z", "modification_date": "2023-07-20T10:20:43.066Z", "country": "Sweden", "product_category": "TOYS", "product_name": "Inflatable ball", "product_name_specific": null, "risk_description": "The blue plastic material of the product has an excessive concentration of diisobutyl phthalate (DIBP) and dibutyl phthalate (DBP) (measured values: up to 0.45 % and to 27.76 %  by weight, respectively). These phthalates may harm the health of children, possibly causing damage to their reproductive system. In addition, the blue plastic has an excessive concentration of short chain chlorinated paraffins (SCCPs) (measured value: up to 3.46 % SCCP by weight). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.\n", "legal_provision": "The product does not comply with the REACH Regulation, nor does it comply with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["W22082360222 B82689 Sj"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10088868, "main": true, "embedding": ""}, {"photo_id": 10088867, "main": false, "embedding": ""}]}