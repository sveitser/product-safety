{"id": 10003078, "reference": "A12/00495/21", "publication_date": "2021-04-08T15:44:09.445Z", "modification_date": "2021-09-03T10:12:49.753Z", "country": "Italy", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo pigment", "product_name_specific": "LIGHT GREEN  ", "risk_description": "The product contains the aromatic amine o-toluidine (measured value: 28.6 mg/kg).\nWhen in direct and prolonged contact with the skin, o-toluidine may be absorbed by the skin.\nO-toluidine may cause cancer, is suspected of causing genetic defects and may cause skin irritation.\n\n\n\n", "legal_provision": "The Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up, recommends that aromatic amines with carcinogenic mutagenic, reprotoxic or sensitising properties should neither be present in tattoos and permanent make-up products nor released from azo-colourants. ", "country_of_origin": "United States", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Intenze"], "model_types": [], "risk_types": ["CHEMICAL"], "measures": ["BAN_MARKETING_OF_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10027679, "main": true, "embedding": ""}, {"photo_id": 10027680, "main": false, "embedding": ""}]}