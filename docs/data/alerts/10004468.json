{"id": 10004468, "reference": "A12/01352/21", "publication_date": "2021-09-23T15:02:41.757Z", "modification_date": "2021-09-23T15:06:20.461Z", "country": "Hungary", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Self-balancing scooter (hoverboard)", "product_name_specific": "HOVERBOARD", "risk_description": "The battery does not have a device that monitors the cells temperature, hence it may overheat during charging, and the hoverboard cover may ignite. The product may cause a fire and the user may suffer burns. In addition, the power cords, which are exposed to movement between the two motors, are routed through a steel pipe with burr edges at both ends. During the life of the product, the insulation of the power cords can be damaged by the sharp edges, the battery may short-circuit and explode during use. As a result, the user might lose control and fall off the scooter and suffer injuries.", "legal_provision": "The product does not comply with the requirements of the of the Low Voltage Directive and of the European standards EN 60335-1, EN 60335-2 and EN 62133.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["airmotion"], "model_types": ["AirMotion H1 (on the packaging)", "H1-FAJ0293 (on the product)"], "risk_types": ["BURNS", "FIRE", "INJURIES"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10036811, "main": true, "embedding": ""}, {"photo_id": 10036808, "main": false, "embedding": ""}, {"photo_id": 10036809, "main": false, "embedding": ""}, {"photo_id": 10036810, "main": false, "embedding": ""}, {"photo_id": 10036812, "main": false, "embedding": ""}, {"photo_id": 10036813, "main": false, "embedding": ""}]}