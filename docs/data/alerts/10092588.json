{"id": 10092588, "reference": "SR/03750/24", "publication_date": "2024-12-17T13:04:19.152Z", "modification_date": "2024-12-17T13:04:27.674Z", "country": "Germany", "product_category": "CHILDCARE_ARTICLES", "product_name": "Children's high chair", "product_name_specific": null, "risk_description": "The product has only a crotch restraint on the belt, not between the seat and the bar. Consequently, if the belt is not used, the child might slip through the opening between the bar and the seat and fall, resulting in injuries, or become trapped with the chest, head or neck between the tray and the seat, resulting in strangulation or entrapment. In addition, the high chair is not sufficiently stable and may tip over while the child is seated. \n", "legal_provision": "The product does not comply with the requirements of the General Product Safety Directive nor with the European standard EN 14988.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["froggy"], "model_types": ["BHCL01"], "risk_types": ["ENTRAPMENT", "INJURIES", "STRANGULATION"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "WARNING_CONSUMERS_OF_RISKS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10940842, "main": true, "embedding": ""}, {"photo_id": 10940840, "main": false, "embedding": ""}, {"photo_id": 10940841, "main": false, "embedding": ""}, {"photo_id": 10940843, "main": false, "embedding": ""}]}