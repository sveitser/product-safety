{"id": 10118754, "reference": "SR/02405/26", "publication_date": "2026-09-03T09:15:58.291Z", "modification_date": "2026-09-17T09:58:35.691Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Electric bicycle", "product_name_specific": "M7 Sport Starsfly E-Bike", "risk_description": "The electric bicycle and its components have not been assessed using relevant conformity assessment procedures. There is no valid technical documentation for the product and no evidence of production control. There is a lack of labelling, marking and instructions. In the absence of evidence to demonstrate the conformity of the bike, battery, and charger, it may be possible for the charger and/or battery to overheat, causing a fire. Additionally, the product was not supplied with a battery. If a consumer purchases and uses a non-compatible battery, it may overheat and cause a fire.", "legal_provision": "The product does not comply with the requirements of the Machinery Directive.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Allegro"], "model_types": ["FY006A", "KYLC165V55 B", "Keyu", "M7 Sport – Starsfly"], "risk_types": ["FIRE"], "measures": ["IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11233296, "main": true, "embedding": ""}, {"photo_id": 11233297, "main": false, "embedding": ""}, {"photo_id": 11233298, "main": false, "embedding": ""}]}