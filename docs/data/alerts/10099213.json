{"id": 10099213, "reference": "SR/01794/26", "publication_date": "2026-06-17T14:53:58.157Z", "modification_date": "2026-06-17T14:54:00.736Z", "country": "Poland", "product_category": "CHILDCARE_ARTICLES", "product_name": "Bicycle seat", "product_name_specific": null, "risk_description": "The bicycle seat attachment system does not have an automatic lock, and the assembly and user manual do not indicate when the system is properly locked. The seat may be attached to the bicycle improperly, which may cause it to detach during a ride, causing injuries to a child. Additionally, the restraint system is ineffective. Moreover, the product has small parts (strap adjuster) that may easily detach. Small children may put them in their mouth and choke.", "legal_provision": "The product does not comply with the General Product Safety Regulation nor with the European standard EN 14344.", "country_of_origin": "Italy", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Bottari"], "model_types": ["BN40124"], "risk_types": ["CHOKING", "INJURIES"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 11009779, "main": true, "embedding": ""}, {"photo_id": 11009780, "main": false, "embedding": ""}, {"photo_id": 11009781, "main": false, "embedding": ""}, {"photo_id": 11009782, "main": false, "embedding": ""}, {"photo_id": 11009783, "main": false, "embedding": ""}]}