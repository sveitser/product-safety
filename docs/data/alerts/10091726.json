{"id": 10091726, "reference": "A12/03030/24", "publication_date": "2024-10-28T09:43:38.890Z", "modification_date": "2024-10-28T09:43:38.893Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Headlight", "product_name_specific": "Outdoor Headlight", "risk_description": "The plastic material of the cable has excessive concentrations of short chain chlorinated paraffins (SCCPs), bis(2-ethylhexyl) phthalate (DEHP) and lead (measured values up to: 0.68%, 0.87% and 0.3% by weight, respectively). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer. This phthalate poses a risk to human health and the environment. Lead poses a risk to the environment.\n\n", "legal_provision": "The product does not comply with the Persistent Organic Pollutants (POP) Regulation nor with the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive).", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10932570, "main": true, "embedding": ""}, {"photo_id": 10932571, "main": false, "embedding": ""}]}