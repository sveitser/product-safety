{"id": 10002627, "reference": "INFO/00183/20", "publication_date": "2020-12-24T23:01:09.692Z", "modification_date": "2020-12-24T23:01:09.741Z", "country": "Finland", "product_category": "TOYS", "product_name": "Soft toy", "product_name_specific": null, "risk_description": "Small parts may easily detach from the toy (nose, eyes and zipper puller). A small child may put them in the mouth and choke on them. The battery compartment’s wire is accessible and too long. It could be put over a child's head, causing a strangulation hazard. Moreover, the plastic of the packaging is too thin: if a child plays with it, it might cover the nose and mouth, causing the child to suffocate. The solder in the battery compartment contains an excessive amount of lead (measured value: 24 % by weight). Lead poses a risk to the environment.", "legal_provision": "The product does not comply with the requirements of the Toy Safety and the RoHS 2 Directives and the relevant European standards EN 71-1 and EN 62115.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "FOR_INFORMATION", "brands": ["Wish"], "model_types": [], "risk_types": ["CHOKING", "ENVIRONMENT", "STRANGULATION", "SUFFOCATION"], "measures": ["WARNING_CONSUMERS_OF_RISKS", "REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10022233, "main": true, "embedding": ""}, {"photo_id": 10022234, "main": false, "embedding": ""}, {"photo_id": 10022235, "main": false, "embedding": ""}, {"photo_id": 10022236, "main": false, "embedding": ""}]}