{"id": 10000284, "reference": "A12/00111/20", "publication_date": "2020-01-21T14:34:43.296Z", "modification_date": "2020-06-16T08:14:12.555Z", "country": "Sweden", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo ink", "product_name_specific": null, "risk_description": "The product contains nickel as well as excessive amounts of zinc, cobalt and arsenic (measured values: 110 mg/kg, 1400 mg/kg, 63 mg/kg and 6,5 mg/kg, respectively).", "legal_provision": "Nickel can cause skin irritation, induce sensitisation or elicit allergic responses.\n\nZinc is toxic and may cause neurological disorders.\n\nCobalt is a skin and respiratory sensitiser and may cause cancer.\n\nArsenic is toxic and might cause cancer. \n\nThe Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up, recommends that the levels of nickel in tattoo inks are as low as technically achievable and that impurities of zinc do not exceed 50 ppm, of cobalt 25 ppm and of arsenic 2 ppm.", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Beauty by Honia "], "model_types": ["Dream Brown"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10003113, "main": true, "embedding": ""}]}