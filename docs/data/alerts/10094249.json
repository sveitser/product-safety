{"id": 10094249, "reference": "SR/01768/25", "publication_date": "2025-05-08T07:37:47.865Z", "modification_date": "2025-05-08T07:37:48.259Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "TOYS", "product_name": "Children's scooter", "product_name_specific": "Dinosaur-Themed Children’s Scooter", "risk_description": "The screw-clamp locking device on the steering column may fail to stop the column from dropping during use. This could cause the child to fall and be injured. Additionally, the product lacks the appropriate instructions for use when folding and unfolding the scooter. If this is not correctly done, it increases the risk of injuries to the user. \nMoreover, the steering column is in a plastic bag which is too thin. If a child plays with it, the plastic can cover the mouth and nose, causing the child to suffocate.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive.", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["INJURIES", "SUFFOCATION"], "measures": ["IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10958589, "main": true, "embedding": ""}]}