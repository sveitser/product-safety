{"id": 10092924, "reference": "SR/00496/25", "publication_date": "2025-01-30T09:32:22.198Z", "modification_date": "2025-02-07T12:45:48.214Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "CHILDCARE_ARTICLES", "product_name": "Baby stroller", "product_name_specific": null, "risk_description": "The stroller’s restraint system did not have a crotch restraint. The child is therefore not properly secured, and can fall and suffer injuries.\nThe product has also a label which can easily detach. A small child can put it in the mouth and choke.\nMoreover, the product also has moving parts which can cause injuries to the child.", "legal_provision": "The product does not comply with the requirements of the General Product Safety Directive", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Hao Shuo"], "model_types": ["956"], "risk_types": ["CHOKING", "INJURIES"], "measures": ["DESTRUCTION_OF_PRODUCT", "IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10946725, "main": true, "embedding": ""}]}