{"id": 10092387, "reference": "A12/03495/24", "publication_date": "2024-12-04T16:06:18.717Z", "modification_date": "2024-12-04T16:06:18.719Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Mirror with LED", "product_name_specific": null, "risk_description": "The solders in the product have an excessive concentration of lead. (measured value: up to 64 % by weight). The plastic material of the cable has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP), dibutyl phthalate (DBP) and short chain chlorinated paraffins (SCCPs) (measured values: up to 1.8 %, 0.3 % and 5.8 % by weight, respectively). Lead poses a risk to the environment. DEHP and DBP pose a risk to human health and the environment. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.\n", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS Directive), nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["H-YT-02"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10938349, "main": true, "embedding": ""}, {"photo_id": 10938350, "main": false, "embedding": ""}]}