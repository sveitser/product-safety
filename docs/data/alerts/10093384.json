{"id": 10093384, "reference": "SR/01077/25", "publication_date": "2025-03-20T10:02:14.885Z", "modification_date": "2025-04-02T08:59:47.125Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Pet cage", "product_name_specific": "Pet Cage & Pet Heating Pad", "risk_description": "The instructions are inadequate in relation to keeping wires out of reach of the pets in the crate. If a pet is placed in the crate and left unsupervised, and the wire for heating the pad is accessible to them, they may bite through the wires, leading to an electric shock. \nMoreover, the heating radiators are not guarded, leaving hot surfaces accessible to the pet. \nAdditionally, the supplied temperature and humidity indicating device presents a choking hazard. Further its button batteries are easily accessible and can lead to internal burns to the pet.", "legal_provision": "The product does not comply with the requirements of the Low Voltage Directive.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["ELECTRIC_SHOCK"], "measures": ["IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10952812, "main": true, "embedding": ""}, {"photo_id": 10952813, "main": false, "embedding": ""}, {"photo_id": 10952814, "main": false, "embedding": ""}, {"photo_id": 10952815, "main": false, "embedding": ""}]}