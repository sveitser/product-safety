{"id": 10093385, "reference": "SR/00895/25", "publication_date": "2025-03-05T11:23:54.484Z", "modification_date": "2025-03-17T14:30:59.056Z", "country": "United Kingdom in respect of Northern Ireland", "product_category": "TOYS", "product_name": "Veterinarian play set", "product_name_specific": "Pet Vet Playset", "risk_description": "The plastic material of the product has an excessive concentration of di-‘isononyl’ phthalate (DINP), (measured value up to: 4.9 % by weight). DINP may harm the health of children, causing possible damage to their reproductive system and liver. Moreover, the plush toy dog has small parts (eyes and nose) which can easily detach. A small child may put them in the mouth and choke. Additionally, the plastic of the packaging is too thin. If a child plays with the packaging, the plastic can cover the mouth and nose, causing the child to suffocate.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive, with the REACH Regulation, nor with the European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Lehoo Castle"], "model_types": [], "risk_types": ["CHEMICAL", "CHOKING", "SUFFOCATION"], "measures": ["DESTRUCTION_OF_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10950938, "main": true, "embedding": ""}, {"photo_id": 10950939, "main": false, "embedding": ""}, {"photo_id": 10950940, "main": false, "embedding": ""}, {"photo_id": 10950941, "main": false, "embedding": ""}]}