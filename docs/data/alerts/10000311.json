{"id": 10000311, "reference": "A12/00020/20", "publication_date": "2020-01-16T12:18:37.547Z", "modification_date": "2020-06-09T06:48:53.415Z", "country": "Sweden", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Exetube", "product_name_specific": "Exetube Strong", "risk_description": "The foam on the handles of the product contains short chain chlorinated paraffins (SCCPs)(measured value up to 2.83 %).", "legal_provision": "The placing on the market and use of articles containing SCCPs is banned. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment.\n\nThe product does not comply with the Regulation on persistent organic pollutants (POP Regulation).", "country_of_origin": "Unknown", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["BLACC"], "model_types": ["Strong"], "risk_types": ["ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "MAKING_MARKETING_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10002814, "main": true, "embedding": ""}]}