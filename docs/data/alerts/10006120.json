{"id": 10006120, "reference": "A12/00820/22", "publication_date": "2022-06-01T15:45:32.810Z", "modification_date": "2022-06-01T15:45:35.651Z", "country": "Sweden", "product_category": "LIGHTING_EQUIPMENT", "product_name": "Track light", "product_name_specific": "Gissi SL 5 black track", "risk_description": "The end piece of the track is not properly anchored, hence live parts can easily be accessed. Furthermore,  the contact pressure is transmitted through insulating material in the internal connections (phase and protective earth) of the luminaire. Hence, the product is improperly designed and does not adequately protected against electric shock. Finally, the screw connection of the protective earth is not adequately locked against loosening, hence the product could go live. The user could consequently touch live parts and receive an electric shock.", "legal_provision": "The product does not comply with the requirements of the Low Voltage Directive nor with the European standards EN 60598-1 and EN 60570.", "country_of_origin": "The Netherlands", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Qazqa"], "model_types": ["92822"], "risk_types": ["ELECTRIC_SHOCK"], "measures": ["STOP_OF_SALES"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10054829, "main": true, "embedding": ""}, {"photo_id": 10054804, "main": false, "embedding": ""}, {"photo_id": 10054808, "main": false, "embedding": ""}, {"photo_id": 10054820, "main": false, "embedding": ""}, {"photo_id": 10054821, "main": false, "embedding": ""}, {"photo_id": 10054825, "main": false, "embedding": ""}, {"photo_id": 10054830, "main": false, "embedding": ""}, {"photo_id": 10054833, "main": false, "embedding": ""}]}