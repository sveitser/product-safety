{"id": 10091740, "reference": "A12/03028/24", "publication_date": "2024-10-28T09:41:59.763Z", "modification_date": "2024-10-28T09:41:59.765Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Remote control", "product_name_specific": "LED remote control", "risk_description": "The plastic material of the cable has excessive concentrations of short chain chlorinated paraffins (SCCPs) and bis(2-ethylhexyl) phthalate (DEHP) (measured values up to: 0.75% and 0.36% by weight, respectively). Moreover, solders in the product have an excessive concentration of lead (measured value up to: 75.5% by weight). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer. The phthalate may harm the health of children by causing possible damage to their reproductive system. And lead poses a risk to the environment.", "legal_provision": "The product does not comply with the Persistent Organic Pollutants (POP) Regulation nor with the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive).", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Not specified"], "model_types": [], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10932579, "main": true, "embedding": ""}, {"photo_id": 10932580, "main": false, "embedding": ""}]}