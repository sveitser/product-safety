{"id": 10003320, "reference": "A12/00337/21", "publication_date": "2021-03-11T23:01:02.706Z", "modification_date": "2021-03-11T23:01:03.447Z", "country": "Luxembourg", "product_category": "PROTECTIVE_EQUIPMENT", "product_name": "Particle filter mask", "product_name_specific": "FFP2 NR Filtering Half Mask", "risk_description": "The product advertises a protective potential against particles but its filtering capacity has not been tested by a relevant competent European conformity assessment body, and it misuses the CE marking and the model name of a different product from the same manufacturer, which is certified. The packaging of the two being identical, there is no possibility for the consumer to see that it is not the certified product.\nIn addition, the product has a complete different shape and size than the certified product, and due to its small size, it does not cover the mouth and nose entirely.\nConsequently, it is not proven that the product fulfils the health and safety requirements; thus, even if combined with other recommended measures, it may not properly protect.", "legal_provision": "The product does not comply with the Personal Protective Equipment Regulation and with the relevant European standard EN 149.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["JIA YUAN"], "model_types": ["JY-KN95"], "risk_types": ["HEALTH_RISK_OTHER"], "measures": ["IMPORT_REJECTED_AT_BORDER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10026271, "main": true, "embedding": ""}, {"photo_id": 10026270, "main": false, "embedding": ""}, {"photo_id": 10026272, "main": false, "embedding": ""}, {"photo_id": 10026273, "main": false, "embedding": ""}, {"photo_id": 10026274, "main": false, "embedding": ""}]}