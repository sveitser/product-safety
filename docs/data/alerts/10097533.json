{"id": 10097533, "reference": "SR/00251/26", "publication_date": "2026-02-09T08:55:05.733Z", "modification_date": "2026-02-10T07:59:25.820Z", "country": "France", "product_category": "TOYS", "product_name": "Toy car", "product_name_specific": "Camion de pompiers avec échelle pompier, grand modèle, jouet, camion d'arrosage", "risk_description": "The battery compartment can easily be opened without use of any tools and the batteries inside are easily accessible. If a child puts them in the mouth, the battery can overheat and release electrolyte which can be ingested by the child and cause damage to the gastrointestinal tract.\n\nMoreover, the child may insert an object into the battery compartment which could create a short circuit, causing the toy to heat up leading to a risk of burns. \n\nAdditionally, the LED light is too powerful. Looking directly into the light beam may damage the eyesight.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standard EN 62115.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["EU822XFCWJ - 04M323 12.08"], "risk_types": ["BURNS", "CHEMICAL", "DAMAGE_TO_SIGHT"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE", "REMOVAL_FROM_ONLINE_MARKETPLACE", "OTHER", "WARNING_CONSUMERS_OF_RISKS", "WARNING_CONSUMERS_OF_RISKS"], "photos": [{"photo_id": 10993775, "main": true, "embedding": ""}, {"photo_id": 10993766, "main": false, "embedding": ""}, {"photo_id": 10993767, "main": false, "embedding": ""}, {"photo_id": 10993768, "main": false, "embedding": ""}, {"photo_id": 10993769, "main": false, "embedding": ""}, {"photo_id": 10993770, "main": false, "embedding": ""}, {"photo_id": 10993771, "main": false, "embedding": ""}, {"photo_id": 10993772, "main": false, "embedding": ""}, {"photo_id": 10993773, "main": false, "embedding": ""}, {"photo_id": 10993774, "main": false, "embedding": ""}]}