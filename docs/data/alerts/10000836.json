{"id": 10000836, "reference": "A12/00396/20", "publication_date": "2020-03-06T11:46:27.615Z", "modification_date": "2021-08-05T10:14:51.810Z", "country": "Hungary", "product_category": "TOYS", "product_name": "Toy gun set", "product_name_specific": null, "risk_description": "The suction cups contain an excessive amount of di-(2-ethylhexyl) phthalate (DEHP) (measured value: 9.6 % by weight), dibutyl phthalate (DBP) (measured value: 15% by weight). These phthalates may harm the health of children causing possible damage to the reproductive system. The suction cups of the projectiles can easily detach. If a child puts the projectile in the mouth, the suction cup may detach and obstruct the airways. The kinetic energy of the projectiles fired from the toy gun is too high and may lead to injuries.", "legal_provision": "The product does not comply with the REACH Regulation and the requirements of the Toy Safety Directive and the relevant European standard EN 71-1.\n", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["Swat"], "model_types": ["Prod: 2017, Lotto N.HS170210"], "risk_types": ["CHEMICAL", "CHOKING", "INJURIES"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10006304, "main": true, "embedding": ""}, {"photo_id": 10006305, "main": false, "embedding": ""}, {"photo_id": 10006306, "main": false, "embedding": ""}]}