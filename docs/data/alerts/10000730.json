{"id": 10000730, "reference": "A12/00418/20", "publication_date": "2020-03-12T14:05:13.910Z", "modification_date": "2020-04-01T05:13:39.252Z", "country": "Luxembourg", "product_category": "TOYS", "product_name": "Soft toy", "product_name_specific": "Shu Yi baby", "risk_description": "The product has small parts that easily detach. The electronic module is accessible and easily breaks releasing small parts, some of which have a high magnetic flux.\n\nA child may put one or more of the small parts in the mouth and choke on them or they could attract one another causing intestinal blockage or perforation.\n\nAdditionally, the plastic material of the shoes and accessions of the product contains an excessive amount of bis(2-ethylhexyl) phthalate (DEHP)(measured value up to: 24 % by weight).\n\nThis phthalate may harm the health of children, causing possible damage to their reproductive system.\n", "legal_provision": "The product does not comply with the REACH Regulation, the requirements of the Toy Safety Directive and the relevant European standard EN 71-1.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["VA"], "model_types": ["ITEM Nº.: 2025"], "risk_types": ["CHEMICAL", "CHOKING", "INJURIES"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "BAN_MARKETING_OF_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10006940, "main": true, "embedding": ""}, {"photo_id": 10006941, "main": false, "embedding": ""}, {"photo_id": 10006942, "main": false, "embedding": ""}, {"photo_id": 10006943, "main": false, "embedding": ""}]}