{"id": 10003705, "reference": "A12/00816/21", "publication_date": "2021-06-04T12:07:23.236Z", "modification_date": "2021-06-04T12:23:41.796Z", "country": "Cyprus", "product_category": "TOYS", "product_name": "Toys", "product_name_specific": "Balloons", "risk_description": "The rubber of the balloons releases an excessive amount of nitrosamines (measured total value: 0.41 mg/ kg) and nitrosatable substances (measured total value: 1.82 mg/kg), which generate nitrosamines among which N-Nitrosodiethylamine (NDEA) and n-nitrosodimethylamine (NDMA). Nitrosamamines may cause cancer through ingestion or dermal exposure. A child could be exposed to them when touching or putting the product in the mouth.\n", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive and the relevant European standard EN 71-12.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["METALLIC BALLOONS"], "model_types": ["SL-10-1"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10031371, "main": true, "embedding": ""}, {"photo_id": 10031372, "main": false, "embedding": ""}]}