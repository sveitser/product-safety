{"id": 10097729, "reference": "SR/00403/26", "publication_date": "2026-03-10T12:54:03.099Z", "modification_date": "2026-04-24T14:04:20.637Z", "country": "France", "product_category": "TOYS", "product_name": "Bath toy", "product_name_specific": "Jouet de bateau rapide électrique pour enfants, modèle de bateau, cadeau", "risk_description": "The battery compartment can easily be opened without use of any tools and the batteries inside are easily accessible. If a child puts them in the mouth, the battery can overheat and release electrolyte which can be ingested by the child and cause damage to the gastrointestinal tract. Furthermore, the product has small parts that can easily detach. A small child may put them in the mouth and choke.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standard EN 62115.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["8836"], "risk_types": ["CHEMICAL", "CHOKING"], "measures": ["WARNING_CONSUMERS_OF_RISKS", "REMOVAL_FROM_ONLINE_MARKETPLACE", "WARNING_CONSUMERS_OF_RISKS", "REMOVAL_FROM_ONLINE_MARKETPLACE", "OTHER"], "photos": [{"photo_id": 10996371, "main": true, "embedding": ""}, {"photo_id": 10996368, "main": false, "embedding": ""}, {"photo_id": 10996369, "main": false, "embedding": ""}, {"photo_id": 10996370, "main": false, "embedding": ""}]}