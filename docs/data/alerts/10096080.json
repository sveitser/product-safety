{"id": 10096080, "reference": "SR/03430/25", "publication_date": "2025-10-01T15:20:57.385Z", "modification_date": "2026-01-07T12:31:10.814Z", "country": "Sweden", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Boxing gloves ", "product_name_specific": "Boxing gloves", "risk_description": "The plastic material of the packaging has an excessive concentrations of bis(2-ethylhexyl) phthalate (DEHP), cadmium and short-chain chlorinated paraffins (SCCPs) (measured values up to 15.4%, 0.03% and 1.02% by weight, respectively). DEHP may harm the health by causing possible damage to the reproductive system. Cadmium is harmful to human health because it accumulates in the body, can damage the kidneys and bones and it may cause cancer. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment.", "legal_provision": "The product does not comply with the REACH Regulation nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Xinyi Toys"], "model_types": ["68699", "TY700-1"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10977798, "main": true, "embedding": ""}, {"photo_id": 10977799, "main": false, "embedding": ""}, {"photo_id": 10977800, "main": false, "embedding": ""}, {"photo_id": 10977801, "main": false, "embedding": ""}]}