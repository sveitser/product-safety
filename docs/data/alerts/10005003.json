{"id": 10005003, "reference": "A11/00002/22", "publication_date": "2022-01-04T10:32:16.606Z", "modification_date": "2022-01-04T10:32:16.610Z", "country": "France", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Liquid detergent for toilets", "product_name_specific": "Liquide sanitaire pour chasse d'eau ", "risk_description": "The product contains skin-sensitizing substances such as methylisothiazolinone (MI) and benzisothiazolinone (BTI) (0.012% and 0.009% by weight, respecively) without a proper labelling (hazard pictogramme and statement, warning sign, risks incurred). Furthermore, the product contains an odoriferous allergen, linalool (0.031% by weight) without indicating it. Dermal contact with MI-containing products can provoke allergic contact dermatitis to sensitised persons. Benzisothiazolinone and linalool are skin sensitisers and can trigger allergic reactions or contact dermatitis.", "legal_provision": "The product does not comply with the Classification, Labelling and Packaging (CLP) Regulation nor with the Regulation on detergents.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_11", "brands": ["Dometic", "MOBILE LIVING - MADE EASY"], "model_types": ["500 ml"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET", "PRODUCT_RECALL_FROM_CONSUMERS", "PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10043202, "main": true, "embedding": ""}, {"photo_id": 10043203, "main": false, "embedding": ""}]}