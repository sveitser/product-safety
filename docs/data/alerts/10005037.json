{"id": 10005037, "reference": "A12/01823/21", "publication_date": "2022-02-17T09:26:05.186Z", "modification_date": "2022-02-17T09:26:05.192Z", "country": "Belgium", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Inflatable floating seat", "product_name_specific": "Car Swimming Ring", "risk_description": "Small parts detach easily from the product. A small child may put them in the mouth and choke. Furthermore, the product is incorrectly labelled as a toy, but should be considered as a floating seat which should be used under constant adult supervision and with specific conditions of use. Therefore, it cannot be designed in such a way that would lead parents and children to confuse it with a toy.", "legal_provision": "The product does not comply with the requirements of the General Product Safety Directive (GPSD).", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["O-Kinee"], "model_types": ["LK-Car Swimming Ring-Purple Yellow", "X001DFEJS3"], "risk_types": ["CHOKING", "DROWNING"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "photos": [{"photo_id": 10042604, "main": true, "embedding": ""}, {"photo_id": 10042601, "main": false, "embedding": ""}, {"photo_id": 10042602, "main": false, "embedding": ""}, {"photo_id": 10042603, "main": false, "embedding": ""}, {"photo_id": 10042605, "main": false, "embedding": ""}, {"photo_id": 10042606, "main": false, "embedding": ""}]}