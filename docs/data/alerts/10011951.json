{"id": 10011951, "reference": "A12/00365/24", "publication_date": "2024-02-15T14:30:30.230Z", "modification_date": "2024-02-15T14:30:30.232Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Electric doorbell", "product_name_specific": "Animerad dörrklocka", "risk_description": "The solders in the product have excessive concentrations of lead and cadmium (measured values: up to 80.3% and 0.25% by weight, respectively). Lead poses a risk to the environment. Cadmium bio-accumulates and poses a risk to the environment. The plastic cable in the product has excessive concentrations of bis(2-ethylhexyl) phthalate (DEHP), dibutyl phthalate (DBP) and short chain chlorinated paraffins (SCCPs) (measured values: up to 0.4%, 1.7% and 0.5% by weight, respectively). These phthalates pose a risk to human health and the environment. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS Directive), nor with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "ARTICLE_12", "brands": ["Dollarstore"], "model_types": ["67555"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10110954, "main": true, "embedding": ""}, {"photo_id": 10110955, "main": false, "embedding": ""}, {"photo_id": 10110956, "main": false, "embedding": ""}]}