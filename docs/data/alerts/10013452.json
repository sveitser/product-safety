{"id": 10013452, "reference": "A12/01633/24", "publication_date": "2024-06-18T16:00:07.150Z", "modification_date": "2025-03-24T10:51:29.283Z", "country": "Sweden", "product_category": "TOYS", "product_name": "Climbing arch / Rocking chair", "product_name_specific": "LUOTO", "risk_description": "A child can get pinching or crushing injuries if they get their fingers or toes between the floor and the runner when sitting in the \"rocking chair\" position.\nIn addition, there are protruding corner posts that could cause children to get stuck with clothes. This can lead to a strangulation risk. \nAdditionally, when the arch is in the climbing position, the distance between the rungs poses a risk of hanging or strangulation, as children could fall through, get their head stuck, and be unable to free themselves.", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standards EN 71-1 and EN 71-8.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Fitwood"], "model_types": [], "risk_types": ["INJURIES", "STRANGULATION"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10125661, "main": true, "embedding": ""}, {"photo_id": 10125660, "main": false, "embedding": ""}]}