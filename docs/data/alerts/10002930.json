{"id": 10002930, "reference": "A12/00182/21", "publication_date": "2021-02-10T14:13:11.578Z", "modification_date": "2021-09-17T08:03:34.120Z", "country": "Norway", "product_category": "HOBBY_SPORTS_EQUIPMENT", "product_name": "Training Bracelet", "product_name_specific": "Smart Bracelet", "risk_description": "The plastic of the charger cord contains an excessive amount of bis(2-ethylhexyl) phthalate (DEHP) and dibutyl phthalate (DBP)(measured values up to 1,8% and 0,6% by weight, respectively). These phthalates may harm the health of children, causing possible damage to their reproductive system. The product also contains short chain chlorinated paraffins (SCCPs) (measured value 17000 mg/kg). The placing on the market and use of articles containing SCCPs is banned. SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment.", "legal_provision": "The product does not comply with REACH Regulation and with Regulation on Persistent Organic Pollutants (POPs).", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Smart Bracelet"], "model_types": ["Training Bracelet/TW64"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET", "REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10023199, "main": true, "embedding": ""}, {"photo_id": 10023200, "main": false, "embedding": ""}, {"photo_id": 10023201, "main": false, "embedding": ""}]}