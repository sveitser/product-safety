{"id": 10002633, "reference": "INFO/00184/20", "publication_date": "2020-12-24T23:01:13.496Z", "modification_date": "2020-12-24T23:01:13.817Z", "country": "Finland", "product_category": "TOYS", "product_name": "Rattle toy", "product_name_specific": null, "risk_description": "Some parts of the toy (the jingle bells) may easily detach. A small child may put them in the mouth and choke on them. Furthermore, if a child puts the toy in the mouth and falls face down, the protruding parts could obstruct the airways, causing choking and injuries around the pharynx or trachea area. Moreover, the plastic bag of the packaging is too thin. If a child plays with the packaging, the plastic can cover the mouth and nose, causing the child to suffocate. ", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive and the relevant European standard EN 71-1.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "FOR_INFORMATION", "brands": [], "model_types": [], "risk_types": ["CHOKING", "INJURIES", "SUFFOCATION"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE", "WARNING_CONSUMERS_OF_RISKS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10022241, "main": true, "embedding": ""}, {"photo_id": 10022242, "main": false, "embedding": ""}]}