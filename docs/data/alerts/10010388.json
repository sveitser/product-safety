{"id": 10010388, "reference": "INFO/00125/23", "publication_date": "2023-10-04T13:59:17.324Z", "modification_date": "2023-10-04T13:59:17.326Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "HDMI cable", "product_name_specific": "Premium Cable HDMI 1.5 meter Högkvalitativ HDMI-k", "risk_description": "The black plastic material has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP) and dibutyl phthalate (DBP) (measured values: 2.44% and 0.21% by weight, respectively). These phthalates may harm the health of children, possibly causing damage to the reproductive system. The product also has an excessive concentration of lead (measured value up to 0.19% by weight). Lead poses a risk to the environment. The plastic cable also has an excessive concentration of short chain chlorinated paraffins (SCCPs), (measured value up to 1.08 % by weight). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive) nor with the Regulation on persistent organic pollutants (POPs).", "country_of_origin": "People's Republic of China", "sold_online": "NO", "notification_type": "FOR_INFORMATION", "brands": [], "model_types": ["A1000896"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["OTHER"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10096271, "main": true, "embedding": ""}, {"photo_id": 10096272, "main": false, "embedding": ""}]}