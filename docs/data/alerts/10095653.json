{"id": 10095653, "reference": "SR/03047/25", "publication_date": "2025-08-19T08:53:48.132Z", "modification_date": "2025-10-03T12:19:55.193Z", "country": "Germany", "product_category": "TOYS", "product_name": "Baby doll", "product_name_specific": null, "risk_description": "The battery compartment in the integrated soundbox of the toy can be easily opened, leaving the button batteries accessible. A child may put them in the mouth and swallow them, which could cause damage to the child’s gastrointestinal tract and/or choking. Additionally, the fibrous stuffing material of the toy is easily accessible due to the weakness of the seams. The product has also  small parts that can easily detach from the clothing (the buttons and pompoms). A small child may put the filling material or the small parts in the mouth and choke.\n", "legal_provision": "The product does not comply with the requirements of the Toy Safety Directive nor with the European standards EN 71-1 and EN 62115.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["kinderplay"], "model_types": ["KP4839"], "risk_types": ["CHEMICAL", "CHOKING"], "measures": ["PRODUCT_RECALL_FROM_CONSUMERS"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10973007, "main": true, "embedding": ""}, {"photo_id": 10973005, "main": false, "embedding": ""}, {"photo_id": 10973006, "main": false, "embedding": ""}]}