{"id": 10009029, "reference": "A12/01254/23", "publication_date": "2023-05-24T07:33:27.582Z", "modification_date": "2023-05-24T07:33:28.900Z", "country": "Ireland", "product_category": "CHILDCARE_ARTICLES", "product_name": "Baby self-feeding pillow", "product_name_specific": null, "risk_description": "The pillow is placed around the baby’s neck, the bottle is held in position by a piece of elastic or a pouch and the baby is positioned on its back to feed itself without the assistance of a caregiver holding the bottle and controlling the feed. In this situation, the baby will not be able to control the flow of milk and the milk will continue to flow even if the baby is not swallowing. This can lead to choking. Choking can be silent and a baby will not have the dexterity or cognitive behaviour to otherwise raise the alarm.", "legal_provision": "This product does not comply with the requirements of the General Product Safety Directive.", "country_of_origin": "People's Republic of China", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": ["Unknown"], "model_types": [], "risk_types": ["CHOKING"], "measures": ["BAN_MARKETING_OF_PRODUCT"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10083240, "main": true, "embedding": ""}]}