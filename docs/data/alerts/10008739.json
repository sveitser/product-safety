{"id": 10008739, "reference": "A12/00986/23", "publication_date": "2023-05-04T07:47:50.339Z", "modification_date": "2025-12-18T09:33:05.241Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "Black camping light ", "product_name_specific": "Lilys Camping light", "risk_description": "The plastic material of the product has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP), (measured value up to 1.7% by weight). This phthalate may harm the health by possibly causing damage to the reproductive system.\nThe plastic material also has an excessive concentration of short-chained chlorinated paraffins (SCCPs) (measured value up to 3.7% by weight). SCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bioaccumulate in wildlife and humans, posing a risk to human health and the environment. \nThe solders in the product have an excessive concentration of lead and cadmium (measured values: up to 79% and 0.13% by weight, respectively). Lead and cadmium pose a risk to the environment.\n", "legal_provision": "The product does not comply with the requirements of the Commission Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive) nor with the Persistent Organic Pollutants (POPs) Regulation.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": ["SH-5800T"], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["REMOVAL_FROM_ONLINE_MARKETPLACE"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10080257, "main": true, "embedding": ""}, {"photo_id": 10080256, "main": false, "embedding": ""}, {"photo_id": 10080258, "main": false, "embedding": ""}, {"photo_id": 10080259, "main": false, "embedding": ""}]}