{"id": 10009748, "reference": "A12/02132/23", "publication_date": "2023-09-14T07:39:44.454Z", "modification_date": "2023-09-14T07:39:44.456Z", "country": "Sweden", "product_category": "ELECTRICAL_APPLIANCES", "product_name": "USB cable", "product_name_specific": "Replacement Cable Charger Cable  USB 2.0 R", "risk_description": "The black plastic material of the product has an excessive concentration of bis(2-ethylhexyl) phthalate (DEHP) (measured values up to 8.87 % by weight). DEHP may harm the health by possibly causing damage to the reproductive system. The black plastic cable also has an excessive concentration of short chain chlorinated paraffins (SCCPs) (measured value up to 0.85 % SCCP by weight).\nSCCPs persist in the environment, are toxic to aquatic organisms at low concentrations and bio-accumulate in wildlife and humans, posing a risk to human health and the environment. Prolonged exposure to them through the skin may cause cancer.\n\n\n", "legal_provision": "The product does not comply with the requirements of the Directive on the restriction of the use of certain hazardous substances in electrical and electronic equipment (RoHS 2 Directive) nor comply with the Persistent Organic Pollutants (POP) Regulation.", "country_of_origin": "Unknown", "sold_online": "YES", "notification_type": "ARTICLE_12", "brands": [], "model_types": [], "risk_types": ["CHEMICAL", "ENVIRONMENT"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10094255, "main": true, "embedding": ""}, {"photo_id": 10094256, "main": false, "embedding": ""}]}