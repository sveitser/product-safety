{"id": 10000289, "reference": "A12/00108/20", "publication_date": "2020-01-21T14:26:13.387Z", "modification_date": "2020-06-16T08:10:44.920Z", "country": "Sweden", "product_category": "CHEMICAL_PRODUCTS", "product_name": "Tattoo ink", "product_name_specific": "Honey Brown", "risk_description": "The product contains nickel (measured value: 17 mg/kg) and an excessive amount of zinc and lead (measured values: 260 mg/kg and 2.3 mg/kg, respectively).\n", "legal_provision": "Nickel can cause skin irritation, induce sensitisation or elicit allergic responses.\n\nZinc is toxic and may cause neurological disorders.\n\nLead is harmful to human health, accumulates in the body, can cause developmental neurotoxicity and may also affect breast-fed or unborn children.\n\nThe Council of Europe Resolution ResAP (2008)1 on requirements and criteria for the safety of tattoos and permanent make-up recommends that the levels of nickel in tattoo inks are as low as technically achievable and that the levels of impurities of zinc do not exceed 50 ppm and of lead 2 ppm.", "country_of_origin": "People's Republic of China", "sold_online": "UNKNOWN", "notification_type": "ARTICLE_12", "brands": ["FABbrows"], "model_types": ["Honey Brown"], "risk_types": ["CHEMICAL"], "measures": ["PRODUCT_WITHDRAWAL_FROM_MARKET"], "embedding_model": "siglip2-b16-256", "embedding_dim": 768, "photos": [{"photo_id": 10003116, "main": true, "embedding": ""}]}